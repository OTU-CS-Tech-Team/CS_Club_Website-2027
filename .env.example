# Public site URL — used for confirm/cancel links in emails.
# Set this in Vercel to your real domain (not localhost), e.g. https://otucsclub.dev
NEXT_PUBLIC_SITE_URL=https://otucsclub.dev

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Public Storage URL for the landing hero recap (mp4). Local fallback is
# /hero/clips/recap.mp4 if this is empty.
NEXT_PUBLIC_HERO_RECAP_URL=https://your-project-ref.supabase.co/storage/v1/object/public/hero/recap.mp4

# Project Settings > API > service_role. Server-only — bypasses RLS, never
# expose to the browser. Used by /api/admin routes and the check-in flow
# for tables admin_users/RLS doesn't cover directly (passport_stamps,
# checkin_tokens, cross-member profile lookups).
SUPABASE_SERVICE_ROLE_KEY=

# Same Resend API key already used for Supabase's SMTP — used directly here
# for app-sent emails (RSVP confirmations, event reminders), since Supabase
# Auth's SMTP hook only sends its own fixed auth emails, not arbitrary ones.
# Prefer: CS Club <contact@yourdomain.com>
RESEND_API_KEY=
RESEND_FROM_EMAIL="CS Club <contact@otucsclub.dev>"

# Random secret — Vercel Cron sends it as "Authorization: Bearer $CRON_SECRET"
# automatically, which is what keeps /api/cron/event-reminders from being a
# public "email everyone" endpoint. Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional dedicated secret for RSVP/mailing confirm & cancel email links.
# Falls back to CRON_SECRET, then SUPABASE_SERVICE_ROLE_KEY.
GUEST_CANCEL_SECRET=
