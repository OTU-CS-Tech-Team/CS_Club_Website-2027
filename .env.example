NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated emails allowed onto /admin. Checked server-side in
# middleware and in the admin page itself.
ADMIN_EMAILS=

# Project Settings > API > service_role. Server-only — bypasses RLS, never
# expose to the browser. Used by /api/admin routes after an admin check.
SUPABASE_SERVICE_ROLE_KEY=

# Same Resend API key already used for Supabase's SMTP — used directly here
# for app-sent emails (RSVP confirmations, event reminders), since Supabase
# Auth's SMTP hook only sends its own fixed auth emails, not arbitrary ones.
RESEND_API_KEY=
RESEND_FROM_EMAIL="CS Club <events@yourdomain.com>"

# Random secret — Vercel Cron sends it as "Authorization: Bearer $CRON_SECRET"
# automatically, which is what keeps /api/cron/event-reminders from being a
# public "email everyone" endpoint. Generate with: openssl rand -hex 32
CRON_SECRET=
